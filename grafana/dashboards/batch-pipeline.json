{
  "id": null,
  "uid": "batch-pipeline",
  "title": "Batch pipeline",
  "description": "Extraction and materialization workers: throughput, cache, cost, queues, reviews and latency",
  "tags": ["bancaemdia", "batch", "celery"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "annotations": {"list": []},
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Extraction throughput (bets/min)",
      "description": "Bets read by the extraction workers per minute, next to the bets written by materialization.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum(rate(batch_bets_processed_total{stage=\"extraction\"}[$__rate_interval])) * 60",
          "legendFormat": "extracted"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum(rate(batch_bets_processed_total{stage=\"materialization\"}[$__rate_interval])) * 60",
          "legendFormat": "materialized"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cache hit rate (%)",
      "description": "Extraction cache lookups served from Redis. Redis errors count as misses.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum(rate(extraction_cache_hit_total[$__rate_interval])) / (sum(rate(extraction_cache_hit_total[$__rate_interval])) + sum(rate(extraction_cache_miss_total[$__rate_interval])))",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cost per bet (USD)",
      "description": "Anthropic spend per extracted bet, cache hits included (ADR-013's cost/bet). Empty while no bet is extracted.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 4, "min": 0}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum(rate(anthropic_cost_usd_total[$__rate_interval])) / (sum(rate(batch_bets_processed_total{stage=\"extraction\"}[$__rate_interval])) > 0)",
          "legendFormat": "per bet"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue depths",
      "description": "Tasks waiting on the broker, all priorities. Tasks already prefetched by a worker are not counted.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "max by (queue) (celery_queue_depth)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Revisão pendente by reason (per hour)",
      "description": "Reviews opened for grave bets, by the conference that opened the reason.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "custom": {"stacking": {"mode": "normal", "group": "A"}, "fillOpacity": 30}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (reason) (rate(revisao_pendente_created_total[$__rate_interval])) * 3600",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "P95 latency per stage",
      "description": "95th percentile of successful task duration. Extraction includes rate-limit waits.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.95, sum by (stage, le) (rate(batch_job_duration_seconds_bucket{status=\"success\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}"
        }
      ]
    }
  ]
}
