    "/api/v1/coleta": {
      "post": {
        "description": "Alias versionado para receber um lote bruto e agendar sua materialização idempotente.",
        "operationId": "receber_coleta_api_v1_coleta_post",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "default": {
                  "summary": "Lote da extensão",
                  "value": {
                    "apostas": [
                      {
                        "id": "BET-123",
                        "odd": 1.95,
                        "status": "open"
                      }
                    ],
                    "capturado_em": "2026-09-22T14:30:00-03:00",
                    "casa": "betano",
                    "contrato": 1
                  }
                }
              },
              "schema": {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "properties": {
                  "apostas": {
                    "items": {
                      "$ref": "#/components/schemas/JsonValue"
                    },
                    "maxItems": 1000,
                    "type": "array"
                  },
                  "capturado_em": {
                    "$ref": "#/components/schemas/JsonValue",
                    "description": "Metadado informativo enviado pela extensão; o servidor o ignora para ordenação e aceita clientes legados."
                  },
                  "casa": {
                    "maxLength": 40,
                    "minLength": 2,
                    "type": "string"
                  },
                  "contrato": {
                    "const": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "contrato",
                  "casa",
                  "apostas"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Malformed collection payload."
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "account_read_only: retain the extension outbox."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid collection token."
          },
          "413": {
            "content": {
              "text/plain": {
                "example": "Content Too Large",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The request body exceeds this endpoint's streaming limit."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The collection rate or daily limit was exceeded."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected internal failure with no sensitive exception details."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The collection was saved but could not be queued."
          }
        },
        "security": [
          {
            "CollectionToken": []
          }
        ],
        "summary": "Receber coleta da extensão"
      }
    },
