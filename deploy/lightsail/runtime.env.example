# Copy to runtime.env (mode 0600). Set unique values with the operator's secret manager.
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://bancaemdia_app:REPLACE@postgres:5432/bancaemdia
DATABASE_URL_REPLICA=postgresql+asyncpg://bancaemdia_app:REPLACE@postgres:5432/bancaemdia
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
RATE_LIMIT_STORAGE=redis://redis:6379/2
RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.30.84.2/32
API_INTERNAL_URL=http://api:8000
S3_UPLOAD_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
AWS_DEFAULT_REGION=REPLACE_WITH_REGION
JWT_SECRET_KEY=REPLACE_WITH_PRIVATE_RSA_KEY_OR_CONFIGURED_ISSUER_KEY
JWT_JWKS_URL=REPLACE_WITH_ISSUER_JWKS_URL
JWT_ALGORITHM=RS256
JWT_AUDIENCE=bancaemdia-api
JWT_ISSUER=bancaemdia-api
COLETA_TOKEN_SECRET=REPLACE
UPLOAD_WEBHOOK_SECRET=REPLACE
ANTHROPIC_API_KEY=REPLACE
