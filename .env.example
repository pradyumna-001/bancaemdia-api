# Application
APP_ENV=development
LOG_LEVEL=INFO
PYTHONPATH=/app/src

# Database
DATABASE_URL=postgresql+asyncpg://bancaemdia:${{ secrets.POSTGRES_PASSWORD }}@localhost:5432/bancaemdia
DATABASE_URL_REPLICA=postgresql+asyncpg://bancaemdia:${{ secrets.POSTGRES_PASSWORD }}@localhost:5432/bancaemdia

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Metrics (prefork workers need an empty PROMETHEUS_MULTIPROC_DIR per container; never set it blank)
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
# WORKER_METRICS_PORT=9808

# JWT (RS256 - generate with: openssl genrsa -out private_key.pem 2048 && openssl rsa -in private_key.pem -pubout -out public_key.pem)
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=RS256
JWT_AUDIENCE=bancaemdia-api
JWT_ISSUER=bancaemdia-api

# Anthropic (for extraction pipeline)
ANTHROPIC_API_KEY=
ANTHROPIC_TIMEOUT=30
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_ESCALATION_MODEL=claude-sonnet-5
ANTHROPIC_RATE_USER=10
ANTHROPIC_RATE_GLOBAL=100
ANTHROPIC_WINDOW=60

# Rate Limiting
RATE_LIMIT_STORAGE=memory://

# Database Timeouts (ms)
STATEMENT_TIMEOUT_PRIMARY=5000
STATEMENT_TIMEOUT_REPLICA=30000

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=